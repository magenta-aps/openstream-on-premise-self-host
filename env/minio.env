# MINIO_BROWSER_REDIRECT_URL is set automatically in compose.yml using SERVER_IP.
# To override it, remove the environment entry from compose.yml and set the value here:
# MINIO_BROWSER_REDIRECT_URL=https://<your-host>:9444
# Must match AWS_S3_KEY/SECRET in backend.env
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
