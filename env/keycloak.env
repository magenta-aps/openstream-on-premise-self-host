# Must match KEYCLOAK_ADMIN_USERNAME/PASSWORD in backend.env
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme_kc_admin

# Must match KC_DB_USERNAME/PASSWORD in db.env
KC_DB_URL=jdbc:postgresql://openstream-db:5432/openstream_keycloak
KC_DB_USERNAME=openstream_keycloak
KC_DB_PASSWORD=changeme_kc

# KC_HOSTNAME is set via SERVER_IP in compose.yml
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
