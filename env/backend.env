#### Django ####
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
DJANGO_ENV=production

MAKE_MIGRATIONS=false
MIGRATE=true

# Path to a JSON file (inside the container) defining realms, users, and memberships
# to provision on every startup. The command is idempotent — safe to leave set.
# See realms.json for the expected format.
REALM_CONFIG_FILE=/app/realms.json

#### Database ####
# Must match POSTGRES_USER/PASSWORD in db.env
DATABASE_HOST=openstream-db
DATABASE_NAME=openstream
DATABASE_USERNAME=openstream
DATABASE_PASSWORD=changeme
DATABASE_PORT=5432

#### Keycloak ####
# KEYCLOAK_REALM_BACKEND_BASE_URL is set automatically in compose.yml using SERVER_IP.
# To override it, remove the environment entry from compose.yml and set the value here:
# KEYCLOAK_REALM_BACKEND_BASE_URL=https://<your-host>:8443
# KEYCLOAK_INTERNAL_HOST is used for backend-to-keycloak calls inside Docker (HTTP)
KEYCLOAK_INTERNAL_HOST=openstream-keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_SCHEME=https
KEYCLOAK_CLIENT_ID=openstream-api
# Must match KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD in keycloak.env
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_kc_admin
KEYCLOAK_WAIT_TIMEOUT=120

#### Frontend / CORS ####
EXPRESS_REFRESH_URL=http://polling-server:3000/trigger-refresh

#### MinIO / S3 ####
# Internal endpoint used by Django to upload/download files (stays HTTP)
AWS_S3_ENDPOINT_URL=http://openstream-minio:9000
# Must match MINIO_ROOT_USER/PASSWORD in minio.env
AWS_S3_KEY=minioadmin
AWS_S3_SECRET=changeme_minio
AWS_S3_BUCKET=infoscreen
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_REGION_NAME=us-east-1
