# BASE_URL, POLLING_URL and COLLAB_URL are set via SERVER_IP in compose.yml

# Where the Express server itself reaches the Django API, as opposed to
# BASE_URL, which is the URL it hands the browser. The two must differ here:
# BASE_URL points at nginx on the host IP with an mkcert certificate that is
# trusted by browsers on the host but not inside this container, so server-side
# reads over it fail TLS verification and the navbar's organisation, sub-org and
# branch names render empty. 'openstream' is the internal Docker service name
# (already in ALLOWED_HOSTS in compose.yml) and is reached over plain HTTP.
INTERNAL_BASE_URL=http://openstream:8000

# HIDE_PAGES soft-hides pages from the navbar (they stay reachable by URL).
# Comma separated, e.g. HIDE_PAGES=/template-store,/emergency-slideshows
HIDE_PAGES=
